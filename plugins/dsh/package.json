{
  "name": "mindforge-dsh-plugin",
  "version": "0.1.1",
  "description": "MindForge memory engine plugin for DeepSeek Harness — local-first, 4-layer memory with encryption",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc --watch",
    "prepack": "tsc -p tsconfig.build.json"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "memory",
    "agent-memory",
    "mindforge",
    "local-first"
  ],
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": false
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ]
}
